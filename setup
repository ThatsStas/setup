#!/bin/bash

# --- Editors: VS Code + opencode ---------------------------------------------
# Installs Visual Studio Code (via Microsoft's official apt repo, so it
# auto-updates with the system) and opencode (the open-source AI coding agent,
# via its official install script).
#
# Guard: run ONLY this step and stop, without the rest of the provisioning, by
# defining INSTALL_EDITORS_ONLY, e.g.:
#     INSTALL_EDITORS_ONLY=1 ./setup
# A normal `./setup` run installs the editors too, then continues.
install_editors() {
    # VS Code: Microsoft apt repository (per https://code.visualstudio.com/docs/setup/linux).
    sudo apt update
    sudo apt install -y wget gpg apt-transport-https
    wget -qO- https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor \
        | sudo tee /usr/share/keyrings/microsoft.gpg > /dev/null
    sudo tee /etc/apt/sources.list.d/vscode.sources > /dev/null <<'VSCODE_SOURCES'
Types: deb
URIs: https://packages.microsoft.com/repos/code
Suites: stable
Components: main
Architectures: amd64,arm64,armhf
Signed-By: /usr/share/keyrings/microsoft.gpg
VSCODE_SOURCES
    sudo apt update
    sudo apt install -y code

    # opencode: official install script (installs to the invoking user's home,
    # so it is NOT run under sudo). See https://opencode.ai/docs/.
    curl -fsSL https://opencode.ai/install | bash
}

if [ -n "${INSTALL_EDITORS_ONLY:-}" ]; then
    install_editors
    exit 0
fi

install_editors

# Add Docker's official GPG key (per https://docs.docker.com/engine/install/ubuntu/):
sudo apt update
sudo apt install -y ca-certificates curl
sudo install -m 0755 -d /etc/apt/keyrings
sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
sudo chmod a+r /etc/apt/keyrings/docker.asc

# Add the repository to Apt sources:
echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
  sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
sudo apt update -y 

sudo apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin vim binutils ca-certificates curl

# --- "Raising the Security Bar" hardening-lab tools (Ubuntu equivalents of the Fedora image) ---
# Toolchain + analysis tools. Ubuntu name differences vs Fedora:
#   pkgconf-pkg-config -> pkg-config, procps-ng -> procps, iproute -> iproute2,
#   rpm-build -> rpm, rust -> rustc, libcmocka-devel -> libcmocka-dev,
#   check-devel -> check, python3-pylint -> pylint.
# perf lives in linux-tools; the -generic metapackage tracks the running kernel.
# libasan/libubsan runtime libs are versioned on Ubuntu (libasanN) and are pulled
# in by gcc, so they are not listed explicitly.
sudo apt install -y \
    gcc clang make cmake meson ninja-build \
    autoconf automake libtool pkg-config bison flex texinfo \
    cpio dpkg-dev \
    checksec binutils elfutils file \
    openssl devscripts \
    linux-tools-common linux-tools-generic \
    openssh-server nftables systemd \
    lynis \
    time \
    procps iproute2 \
    git tree \
    libcmocka-dev check \
    pylint python3-pip \
    cargo rustc \
    util-linux-extra 

# FFmpeg dev libs for the FreeRDP build target (Fedora's ffmpeg-free-devel).
sudo apt install -y libavcodec-dev libavutil-dev libavformat-dev

# Enable deb-src source repositories so `apt build-dep` can resolve build deps.
# Ubuntu 24.04+ ships the deb822 format (ubuntu.sources) with only `Types: deb`;
# 22.04 and earlier use the legacy sources.list with commented `# deb-src` lines.
if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then
    # deb822: append `deb-src` to any `Types:` line that lacks it.
    sudo sed -i -E '/^Types:/{/deb-src/!s/$/ deb-src/}' \
        /etc/apt/sources.list.d/ubuntu.sources
fi
if grep -q '^# deb-src' /etc/apt/sources.list 2>/dev/null; then
    # legacy: uncomment the deb-src lines.
    sudo sed -i 's/^# deb-src/deb-src/' /etc/apt/sources.list
fi
sudo apt update

# Build dependencies for the offline C/C++ targets. On Ubuntu this is `apt build-dep`,
# which needs the source (deb-src) repositories enabled above.
sudo apt build-dep -y bzip2 libxml2 assimp imagemagick  || \
    echo "apt build-dep failed: check that deb-src repositories are enabled, then re-run the build-dep line"

sudo usermod -aG docker $USER

newgrp docker


# building the docker image for fedora packaging
git clone https://github.com/nmanthey/hardening-lab.git

pushd hardening-lab/lab-2026

make build

popd


# --- Custom login banner (MOTD) ---
# Ubuntu prints /etc/update-motd.d/* output at login via pam_motd. A low number
# makes this banner appear first. The heredoc is single-quoted so the block
# characters are written verbatim.
sudo tee /etc/update-motd.d/01-custom-banner > /dev/null <<'MOTD_SCRIPT'
#!/bin/sh
cat <<'BANNER'

▄█████ ▄▄▄▄▄  ▄▄▄▄ ▄▄ ▄▄ ▄▄▄▄  ▄▄ ▄▄▄▄▄▄ ▄▄ ▄▄   ██  ██  ▄▄▄  ▄▄▄▄  ▄▄▄▄  ▄▄▄▄▄ ▄▄  ▄▄ ▄▄ ▄▄  ▄▄  ▄▄▄▄   ██      ▄▄▄  ▄▄▄▄  
▀▀▀▄▄▄ ██▄▄  ██▀▀▀ ██ ██ ██▄█▄ ██   ██   ▀███▀   ██████ ██▀██ ██▄█▄ ██▀██ ██▄▄  ███▄██ ██ ███▄██ ██ ▄▄   ██     ██▀██ ██▄██ 
█████▀ ██▄▄▄ ▀████ ▀███▀ ██ ██ ██   ██     █     ██  ██ ██▀██ ██ ██ ████▀ ██▄▄▄ ██ ▀██ ██ ██ ▀██ ▀███▀   ██████ ██▀██ ██▄█▀

BANNER
MOTD_SCRIPT
sudo chmod +x /etc/update-motd.d/01-custom-banner
